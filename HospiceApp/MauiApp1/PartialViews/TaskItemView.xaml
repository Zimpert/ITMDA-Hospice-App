<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.PartialViews.TaskItemView">
    <Frame CornerRadius="10" Padding="0" BackgroundColor="Transparent" HasShadow="False" Margin="0,10,0,0">
        <Grid Padding="10" BackgroundColor="#9855AE">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackLayout Grid.Column="1" VerticalOptions="Center" >
                <Label x:Name="TaskTitleLabel" FontAttributes="Bold" TextColor="White"/>
                <Label x:Name="TaskDescriptionLabel" FontSize="Small" TextColor="White"/>
            </StackLayout>

            <CheckBox x:Name="TaskCompletionCheckBox" VerticalOptions="Center" Grid.Column="2"/>
        </Grid>
    </Frame>
</ContentView>
