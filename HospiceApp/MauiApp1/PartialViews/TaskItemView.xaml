<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.PartialViews.TaskItemView">
    <StackLayout Orientation="Horizontal" Spacing="10" Padding="10" BackgroundColor="Black" >
        <StackLayout VerticalOptions="CenterAndExpand">
            <Label x:Name="TaskTitleLabel" FontAttributes="Bold" TextColor="White"/>
            <Label x:Name="TaskDescriptionLabel" FontSize="Small" TextColor="White"/>
        </StackLayout>
        <CheckBox x:Name="TaskCompletionCheckBox" VerticalOptions="Center" />
    </StackLayout>
</ContentView>
