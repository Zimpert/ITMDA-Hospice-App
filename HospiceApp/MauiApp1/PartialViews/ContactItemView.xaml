<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.PartialViews.ContactItemView"
             xmlns:models="clr-namespace:MauiApp1.Models"
             x:DataType="models:ContactItem">
    <Frame CornerRadius="10" Padding="10" BackgroundColor="#9b59b6" HasShadow="True" Margin="0,10">
        <Grid ColumnDefinitions="Auto, *, Auto, Auto, Auto" RowDefinitions="Auto">
            <!-- Avatar -->
            <Image Source="User.png" HeightRequest="50" WidthRequest="50"
                   VerticalOptions="Center" Margin="10,0,20,0" />

            <!-- Contact Information -->
            <StackLayout Grid.Column="1" VerticalOptions="Center">
                <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="Medium" TextColor="Black" />
                <Label Text="{Binding Surname}" FontSize="Small" TextColor="White" />
            </StackLayout>

            <!-- Details Button -->
            <!--<Button Text="Details" BackgroundColor="#341d5c" TextColor="White" CornerRadius="10"
                    FontSize="Small" HeightRequest="40" 
                    VerticalOptions="Center" Grid.Column="2" />-->
            
            <!-- Medication Button -->
            <Button Text="Medication" BackgroundColor="#341d5c" TextColor="White" CornerRadius="10"
                    FontSize="Small" HeightRequest="40" 
                    VerticalOptions="Center" Grid.Column="3"
                    Command="{Binding NavToMedListCommand}" CommandParameter="{Binding PatientID}"/>
            
            <!-- Tasks Button -->
            <!--<Button Text="Tasks" BackgroundColor="#341d5c" TextColor="White" CornerRadius="10"
                    FontSize="Small" HeightRequest="40" 
                    VerticalOptions="Center" Grid.Column="4" />-->
        </Grid>
    </Frame>
</ContentView>
