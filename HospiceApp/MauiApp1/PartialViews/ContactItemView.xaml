<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.PartialViews.ContactItemView">
    <Frame CornerRadius="10" Padding="10" BackgroundColor="#9b59b6" HasShadow="True" Margin="0,10">
        <Grid ColumnDefinitions="Auto, *, Auto" RowDefinitions="Auto">
            <!-- Avatar -->
            <Image Source="placeholder.png" HeightRequest="50" WidthRequest="50"
                   VerticalOptions="Center" Margin="10,0,20,0" />

            <!-- Contact Information -->
            <StackLayout Grid.Column="1" VerticalOptions="Center">
                <Label x:Name="NameLabel" FontAttributes="Bold" FontSize="Medium" TextColor="Black" />
                <Label x:Name="DetailsLabel" FontSize="Small" TextColor="White" />
            </StackLayout>

            <!-- Details Button -->
            <Button Text="Details" BackgroundColor="#341d5c" TextColor="White" CornerRadius="10"
                    FontSize="Small" HeightRequest="40" 
                    VerticalOptions="Center" Grid.Column="2" />
        </Grid>
    </Frame>
</ContentView>
