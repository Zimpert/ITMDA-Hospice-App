<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.LoginPage"
             xmlns:viewModels="clr-namespace:MauiApp1.ViewModels"
             x:DataType="viewModels:LoginViewModel"
             Title="LoginPage"
             BackgroundColor="#f5f5f5">

    <VerticalStackLayout Padding="40" Spacing="20" HorizontalOptions="Center" VerticalOptions="Center">
        <!-- Title -->
        <Label Text="Welcome!"
               FontSize="32"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               TextColor="#333" />

        <!-- Subtitle -->
        <Label Text="Please login to continue"
               FontSize="16"
               HorizontalOptions="Center"
               TextColor="#888" />

        <!-- Email Entry -->
        <Frame BackgroundColor="White" CornerRadius="10" HasShadow="True" Padding="10">
            <Entry Placeholder="Email"
                   Text="{Binding LoginText}"
                   Keyboard="Email"
                   PlaceholderColor="#aaa"
                   TextColor="#333"
                   FontSize="16" />
        </Frame>

        <!-- Password Entry -->
        <Frame BackgroundColor="White" CornerRadius="10" HasShadow="True" Padding="10">
            <Entry Placeholder="Password"
                   IsPassword="True"
                   Text="{Binding PasswordText}"
                   PlaceholderColor="#aaa"
                   TextColor="#333"
                   FontSize="16" />
        </Frame>

        <!-- Login Button -->
        <Button Text="Login"
                Command="{Binding LoginCommand}"
                BackgroundColor="#4CAF50"
                TextColor="White"
                CornerRadius="10"
                FontSize="18"
                HeightRequest="50"
                HorizontalOptions="FillAndExpand" />
    </VerticalStackLayout>
</ContentPage>
