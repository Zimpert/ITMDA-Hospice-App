<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.CaretakerQR">
    
    <StackLayout Padding="20" BackgroundColor="White">

        <!-- Header with title and settings icon -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Back Arrow -->
            <Image Source="arrow_left.png" 
                   VerticalOptions="Center" 
                   HeightRequest="40"
                   WidthRequest="40"/>

            <!-- Title -->
            <Label Text="QR Code" 
               Grid.Column="1" 
               FontSize="Title" 
               TextColor="Black"
               HorizontalOptions="Center" 
               VerticalOptions="Center" />

            <!-- Settings Icon -->
            <Image Source="settings.png" 
               Grid.Column="2" 
               VerticalOptions="Center" 
               HeightRequest="40"
               WidthRequest="40"/>
        </Grid>

        <!-- Profile Picture -->
        <Frame HeightRequest="100" WidthRequest="100"
           CornerRadius="50" 
           BackgroundColor="Purple"
           VerticalOptions="Center"
           HorizontalOptions="Center"
           Margin="0,20,0,10">
            <Image Source="placeholder.png" 
               VerticalOptions="Center"
               HorizontalOptions="Center"/>
        </Frame>

        <!-- Name and Role -->
        <Label Text="Alexa Williams" 
           FontSize="Large" 
           TextColor="Black"
           HorizontalOptions="Center" />
        <Label Text="Caregiver" 
           FontSize="Medium" 
           TextColor="Black"
           HorizontalOptions="Center"
           Margin="0,0,0,20"/>

        <!-- Description Text -->
        <Label Text="Your personal QR code."
           TextColor="Black"
           FontSize="Small"
           HorizontalTextAlignment="Start"
           Margin="20,0,0,0" />
        <Label Text="Patients will scan this code to clock you in and out."
           TextColor="Black"
           FontSize="Small"
           HorizontalTextAlignment="Start"
           Margin="20,0,0,20" />

        <!-- Clock In/Out Radio Buttons -->
        <StackLayout Orientation="Horizontal" HorizontalOptions="Center" Margin="0,0,0,20">
            <Image Source="placeholder.png" VerticalOptions="Center" Margin="0,0,0,0"  HeightRequest="60" WidthRequest="60"/>
            <StackLayout>
                <StackLayout Orientation="Horizontal" VerticalOptions="Center">
                    <RadioButton Content="Clocked In" IsChecked="True" TextColor="Black" Margin="20,5,0,0"/>
                    <RadioButton Content="Clocked Out" IsChecked="False" TextColor="Black" Margin="10,5,0,0"/>
                </StackLayout>
            </StackLayout>
        </StackLayout>

        <!-- QR Code Image -->
        <Frame HeightRequest="200" WidthRequest="200" BorderColor="Gray" CornerRadius="10" HorizontalOptions="Center" VerticalOptions="Center">
            <Image Source="placeholder.png" Aspect="AspectFit"/>
        </Frame>

        <!-- Save Button -->
        <Button Text="Save to Camera Roll" 
            BackgroundColor="Green" 
            TextColor="Black" 
            FontSize="Medium"
            CornerRadius="10"
            VerticalOptions="End" 
            HorizontalOptions="FillAndExpand"
            Margin="0,20,0,0" />

    </StackLayout>
    
</ContentPage>