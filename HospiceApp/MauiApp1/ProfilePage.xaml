<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.ProfilePage"
             Title="Profile">
    <StackLayout Padding="10">
        <Label Text="User Profile" FontSize="Large" HorizontalOptions="Center" />
        <Label Text="Name:" />
        <Label Text="{Binding User.Name}" />
        <Label Text="Surname:"  />
        <Label Text="{Binding User.Surname}" />
        <Label Text="Email:"  />
        <Label Text="{Binding User.Email}" />
        <Label Text="Phone Number:"  />
        <Label Text="{Binding User.PhoneNo}" />
        <Label Text="Address:"  />
        <Label Text="{Binding User.Address}" />
        <Label Text="Role:"  />
        <Label Text="{Binding User.Role}" />
    </StackLayout>
</ContentPage>
