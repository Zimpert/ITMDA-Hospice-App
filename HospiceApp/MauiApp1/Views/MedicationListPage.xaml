<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Views.MedicationListPage"
             xmlns:vm ="clr-namespace:MauiApp1.ViewModels"
                x:DataType="vm:MedicationListViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#FAFAFA">

    <Grid Padding="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Navbar with Title and Settings Icon -->
        <Frame Grid.Row="0" BackgroundColor="#9b59b6" CornerRadius="0" HasShadow="True"
       HorizontalOptions="FillAndExpand" VerticalOptions="Start">
            <Grid Padding="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Back button on the left -->
                <ImageButton Grid.Column="0"
                     Source="arrow_left.png"
                     BackgroundColor="Transparent"
                     WidthRequest="30"
                     HeightRequest="30"
                     VerticalOptions="Center"
                     Aspect="AspectFit"
                     Clicked="OnBackButtonTapped" />

                <!-- Home Title in the center -->
                <Label Grid.Column="1"
               Text="Medication List"
               FontAttributes="Bold"
               VerticalOptions="Center"
               HorizontalOptions="Center"
               FontSize="18"
               TextColor="White" />

                <!-- Settings Icon on the right -->
                <ImageButton Grid.Column="2"
                     Source="settings.png"
                     BackgroundColor="Transparent"
                     WidthRequest="30"
                     HeightRequest="30"
                     VerticalOptions="Center"
                     Aspect="AspectFit"
                     Clicked="OnSettingsIconTapped" />
            </Grid>
        </Frame>

        <!-- Search Bar -->
        <Frame Grid.Row="1" BackgroundColor="#FDEFFB" CornerRadius="15" Padding="10" Margin="0,20,0,10" HasShadow="True">
            <StackLayout Orientation="Horizontal" Spacing="10">
                <Image Source="search_icon.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center"/>
                <Entry Placeholder="Search medication"
                       PlaceholderColor="#9b59b6"
                       TextColor="#333"
                       BackgroundColor="Transparent"
                       VerticalOptions="Center"
                       HorizontalOptions="FillAndExpand"/>
            </StackLayout>
        </Frame>

        <!-- Medication List -->
        <CollectionView ItemsSource="{Binding MedicationDays}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <StackLayout Padding="10">
                        <Label Text="{Binding MedicationName}" FontSize="20" />
                        <Label Text="{Binding Day}" FontSize="16" />
                        <Label Text="{Binding Dosage}" FontSize="16" />
                        <Label Text="{Binding StartDate, StringFormat='Start Date: {0:MM/dd/yyyy}'}" FontSize="14" />
                        <Label Text="{Binding EndDate, StringFormat='End Date: {0:MM/dd/yyyy}'}" FontSize="14" />
                        <Label Text="{Binding Inderactions}" FontSize="14" />
                    </StackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>


        <!-- Action Button -->
        <Frame Grid.Row="3"
       BackgroundColor="#9b59b6"
       CornerRadius="30"
       WidthRequest="60"
       HeightRequest="60"
       Padding="0"
       Margin="0,0,20,20"
       HorizontalOptions="End"
       VerticalOptions="End"
       HasShadow="True">
            <Button Text="+" 
            BackgroundColor="#9b59b6" 
            TextColor="White" 
            CornerRadius="30" 
            WidthRequest="60" 
            HeightRequest="60"
            FontAttributes="Bold" 
            FontSize="28" 
            Clicked="OnAddMedicationClicked"/>
        </Frame>

    </Grid>
</ContentPage>
