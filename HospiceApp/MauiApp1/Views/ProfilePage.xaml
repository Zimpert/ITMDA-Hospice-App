<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.ProfilePage"
             Title="Profile"
             BackgroundColor="White"
             >
    <StackLayout Padding="10" Spacing="15">
        <!-- Navbar with Profile Icon, Title, and Settings Icon -->
        <Grid Grid.Row="0" BackgroundColor="purple" Padding="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Back Button  on the left -->
            <ImageButton Grid.Column="0"
             Source="arrow_left.png"
             WidthRequest="30"
             HeightRequest="30"
             VerticalOptions="Center"
             Clicked="OnBackButtonTapped" />

            <!-- Home Title in the center -->
            <Label Grid.Column="1"
            Text="Profile"
            FontAttributes="Bold"
            VerticalOptions="Center"
            HorizontalOptions="Center"
            FontSize="Title" />

            <!-- Settings Icon  on the right -->
            <ImageButton Grid.Column="2"
                  Source="settings.png"
                  WidthRequest="30"
                  HeightRequest="30"
                  VerticalOptions="Center"
                  Clicked="OnSettingsIconTapped" />
        </Grid>

        <!-- Input Fields -->
        <StackLayout Spacing="10">
            <Label Text="First name" TextColor="White"/>
            <Entry Text="{Binding User.FirstName}" Placeholder="First name" BackgroundColor="#9b59b6" PlaceholderColor="White"/>

            <Label Text="Last name" TextColor="White"/>
            <Entry Text="{Binding User.LastName}" Placeholder="Last name" BackgroundColor="#9b59b6" PlaceholderColor="White"/>

            <Label Text="Email" TextColor="White"/>
            <Entry Text="{Binding User.Email}" Placeholder="Email" BackgroundColor="#9b59b6" PlaceholderColor="White"/>

            <Label Text="Phone number" TextColor="White"/>
            <Entry Text="{Binding User.PhoneNo}" Placeholder="Phone number" BackgroundColor="#9b59b6" PlaceholderColor="White"/>

            <Label Text="Emergency contact" TextColor="White"/>
            <Entry Text="{Binding User.EmergencyContact}" Placeholder="Not provided" BackgroundColor="#9b59b6" PlaceholderColor="White"/>
                
        </StackLayout>

        <!-- Update Information Button -->
        <Button Text="Update Information" BackgroundColor="Green" TextColor="White" 
                HeightRequest="50" HorizontalOptions="FillAndExpand" />
    </StackLayout>
</ContentPage>
