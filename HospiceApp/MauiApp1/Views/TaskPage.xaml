<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Views.TaskPage"
             Shell.NavBarIsVisible="False"
             xmlns:viewmodels="clr-namespace:MauiApp1.ViewModels">
    <ScrollView>
        <StackLayout BackgroundColor="White">

            <!-- Header -->
            <Frame BackgroundColor="#9b59b6" CornerRadius="0" HasShadow="True"
                   HorizontalOptions="FillAndExpand" VerticalOptions="Start">
                <Grid Padding="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Back button on the left -->
                    <ImageButton Grid.Column="0"
                                 Source="arrow_left.png"
                                 BackgroundColor="Transparent"
                                 WidthRequest="30"
                                 HeightRequest="30"
                                 VerticalOptions="Center"
                                 Aspect="AspectFit"
                                 Clicked="OnBackButtonTapped" />

                    <!-- Home Title in the center -->
                    <Label Grid.Column="1"
                           Text="Tasks"
                           FontAttributes="Bold"
                           VerticalOptions="Center"
                           HorizontalOptions="Center"
                           FontSize="18"
                           TextColor="White" />

                    <!-- Settings Icon on the right -->
                    <ImageButton Grid.Column="2"
                                 Source="settings.png"
                                 BackgroundColor="Transparent"
                                 WidthRequest="30"
                                 HeightRequest="30"
                                 VerticalOptions="Center"
                                 Aspect="AspectFit"
                                 Clicked="OnSettingsIconTapped" />
                </Grid>
            </Frame>
            <StackLayout Padding="20,0,20,0">
                <!-- Task List -->
                <Label Text="Tasks" 
                   FontAttributes="Bold" 
                   FontSize="Medium" 
                   TextColor="Black" 
                   Margin="0,10,0,0" />

                <CollectionView ItemsSource="{Binding Tasks}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <!-- Frame with purple background color -->
                            <Frame BackgroundColor="Purple" CornerRadius="10" Padding="10" Margin="5">
                                <Grid ColumnDefinitions="*,Auto">
                                    <!-- Task Details StackLayout -->
                                    <StackLayout Grid.Column="0" VerticalOptions="Center">
                                        <Label Text="Task:" FontAttributes="Bold" TextColor="White" />
                                        <Label Text="{Binding Description}" FontSize="Small" TextColor="White" />
                                        <Label Text="{Binding DateDue}" FontSize="Small" TextColor="White" />
                                        <Label Text="{Binding TaskID}" IsVisible="True" TextColor="White" />
                                    </StackLayout>

                                    <!-- Task Completion Button -->
                                    <Button Grid.Column="1"
                                    Text="Complete"
                                    VerticalOptions="Center"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:TaskViewModel}}, Path=TaskCompletionCommand}"
                                    CommandParameter="{Binding TaskID}" />
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Button Text="Add Task" Command="{Binding AddTaskCommand}"/>

            </StackLayout>
        </StackLayout>
    </ScrollView>
</ContentPage>
