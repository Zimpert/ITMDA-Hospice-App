<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Views.TaskPage"
             Shell.NavBarIsVisible="False">
    <ScrollView>
        <StackLayout BackgroundColor="White">

            <!-- Header -->
            <Frame BackgroundColor="#9b59b6"
                   CornerRadius="0"
                   HasShadow="True"
                   HorizontalOptions="FillAndExpand"
                   VerticalOptions="Start">
                <Grid Padding="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Back button on the left -->
                    <ImageButton Grid.Column="0"
                                 Source="arrow_left.png"
                                 BackgroundColor="Transparent"
                                 WidthRequest="30"
                                 HeightRequest="30"
                                 VerticalOptions="Center"
                                 Aspect="AspectFit"
                                 Clicked="OnBackButtonTapped" />

                    <!-- Home Title in the center -->
                    <Label Grid.Column="1"
                           Text="Tasks"
                           FontAttributes="Bold"
                           VerticalOptions="Center"
                           HorizontalOptions="Center"
                           FontSize="18"
                           TextColor="White" />

                    <!-- Settings Icon on the right -->
                    <ImageButton Grid.Column="2"
                                 Source="settings.png"
                                 BackgroundColor="Transparent"
                                 WidthRequest="30"
                                 HeightRequest="30"
                                 VerticalOptions="Center"
                                 Aspect="AspectFit"
                                 Clicked="OnSettingsIconTapped" />
                </Grid>
            </Frame>
            <StackLayout Padding="20,0,20,0">
                <!-- Date Picker -->
                <Label Text="Select Date"
                       FontAttributes="Bold"
                       FontSize="Medium"
                       TextColor="Black"
                       Margin="0,10,0,0"
                       HorizontalOptions="Center" />

                <Frame BackgroundColor="#F3F0FF"
                       CornerRadius="10"
                       Padding="10"
                       Margin="0,20,0,0"
                       HasShadow="True">
                    <DatePicker x:Name="DatePicker"
                                Margin="0,20,0,20"
                                BackgroundColor="#F3F0FF"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                DateSelected="OnDateSelected"
                                TextColor="Black"
                                FontSize="Large" />
                </Frame>

                <!-- Task List -->
                <Label Text="Tasks"
                       FontAttributes="Bold"
                       FontSize="Medium"
                       TextColor="Black"
                       Margin="0,10,0,0"
                       HorizontalOptions="Center" />
                <StackLayout x:Name="TaskListContainer" />

                <!-- Notes Section -->
                <!--
                <Label Text="Notes" 
                   FontAttributes="Bold" 
                   FontSize="Medium" 
                   TextColor="Black" 
                   Margin="0,10,0,0" 
                   HorizontalOptions="Center"/>
                
                <Editor x:Name="NotesEditor" 
                    BackgroundColor="#9855AE" 
                    HeightRequest="100" 
                    Margin="0,10,0,0" 
                    TextColor="Black" />-->

            </StackLayout>
        </StackLayout>
    </ScrollView>
</ContentPage>
