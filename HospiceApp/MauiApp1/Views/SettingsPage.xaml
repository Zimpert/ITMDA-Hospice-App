<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Views.SettingsPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource BackgroundColor}">

    <!-- Use a StackLayout to wrap all content -->
    <StackLayout BackgroundColor="{DynamicResource BackgroundColor}">

        <!-- Navbar with Title and Settings Icon -->
        <Frame Grid.Row="0" BackgroundColor="#9b59b6" Padding="10" CornerRadius="0" HasShadow="True">
            <Grid Padding="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Back button on the left -->
                <ImageButton Grid.Column="0"
                             Source="arrow_left.png"
                             BackgroundColor="Transparent"
                             WidthRequest="30"
                             HeightRequest="30"
                             VerticalOptions="Center"
                             Aspect="AspectFit"
                             Clicked="OnBackButtonTapped" />

                <!-- Title in the center -->
                <Label Grid.Column="1"
                       Text="Settings"
                       FontAttributes="Bold"
                       VerticalOptions="Center"
                       HorizontalOptions="Center"
                       FontSize="18"
                       TextColor="White" />

                <!-- Settings Icon on the right -->
                <ImageButton Grid.Column="2"
                             Source="settings.png"
                             BackgroundColor="Transparent"
                             WidthRequest="30"
                             HeightRequest="30"
                             VerticalOptions="Center"
                             Aspect="AspectFit"
                             Clicked="OnSettingsIconTapped" />
            </Grid>
        </Frame>

        <!-- Settings Options -->
        <StackLayout Padding="10" Spacing="20">

            <!-- Theme Label, Icon, and Toggle -->
            <Frame Padding="0" BackgroundColor="#D18EF6" CornerRadius="8" HasShadow="False">
                <Grid Padding="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Icon Column -->
                    <Image Source="placeholder.png" HeightRequest="30" WidthRequest="30" VerticalOptions="Center" Grid.Column="0" />

                    <!-- Theme Label -->
                    <Label Text="Light/Dark Mode" FontSize="Medium" TextColor="{DynamicResource TextColor}" VerticalOptions="Center" Padding="10,0,0,0" Grid.Column="1" />

                    <!-- Toggle Switch -->
                    <Switch x:Name="ThemeSwitch" VerticalOptions="Center" HorizontalOptions="End" Grid.Column="2"   Toggled="OnThemeSwitchToggled" />
                </Grid>
            </Frame>


            <!-- Contact Support -->
            <Frame Padding="0" BackgroundColor="#D18EF6" CornerRadius="8" HasShadow="False">
                <Grid Padding="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Icon Column -->
                    <Image Source="placeholder.png" HeightRequest="30" WidthRequest="30" VerticalOptions="Center" Grid.Column="0" />

                    <!-- Description Column -->
                    <Label Text="Contact Support" FontSize="Medium" TextColor="{DynamicResource TextColor}" VerticalOptions="Center" Padding="10,0,0,0" Grid.Column="1" />

                    <!-- Action Text Column -->
                    <Label Text="Get Help" FontSize="Small" TextColor="{DynamicResource TextColor}" VerticalOptions="Center" HorizontalOptions="End" Grid.Column="2" />
                </Grid>
            </Frame>

            <!-- Logout -->
            <Frame Padding="0" BackgroundColor="#D18EF6" CornerRadius="8" HasShadow="False">
                <Grid Padding="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Icon Column -->
                    <Image Source="placeholder.png" HeightRequest="30" WidthRequest="30" VerticalOptions="Center" Grid.Column="0" />

                    <!-- Description Column -->
                    <Label Text="Logout" FontSize="Medium" TextColor="{DynamicResource TextColor}" VerticalOptions="Center" Padding="10,0,0,0" Grid.Column="1" />

                    <!-- Action Text Column -->
                    <Label Text="Sign out" FontSize="Small" TextColor="{DynamicResource TextColor}" VerticalOptions="Center" HorizontalOptions="End" Grid.Column="2" />
                </Grid>
            </Frame>
        </StackLayout>
    </StackLayout>
</ContentPage>
