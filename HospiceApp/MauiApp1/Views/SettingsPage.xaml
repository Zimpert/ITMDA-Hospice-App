<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.SettingsPage"
             BackgroundColor="white">
    <StackLayout Padding="20">

        <!-- Header -->
        <Grid Padding="0,10,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Image Source="arrow_left.png" HeightRequest="30" WidthRequest="30" VerticalOptions="Center"/>
            <Label Text="Settings" FontSize="Title" TextColor="Black" HorizontalOptions="Center" Grid.Column="1"/>
        </Grid>

        <!-- Settings Options -->
        <StackLayout Spacing="20">

            <!-- Dark/Light Mode Toggle -->
            <Frame Padding="0" BackgroundColor="#D18EF6" CornerRadius="8" HasShadow="False">
                <Grid Padding="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon Column -->
                    <Image Source="placeholder.png" HeightRequest="30" WidthRequest="30" VerticalOptions="Center" Grid.Column="0"/>

                    <!-- Description Column -->
                    <Label Text="Dark/Light Mode" FontSize="Medium" TextColor="Black" VerticalOptions="Center" Padding="10,0,0,0" Grid.Column="1"/>

                    <!-- Action Text Column -->
                    <Label Text="Change" FontSize="Small" TextColor="Black" VerticalOptions="Center" HorizontalOptions="End" Grid.Column="2"/>
                </Grid>
            </Frame>

            <!-- Contact Support -->
            <Frame Padding="0" BackgroundColor="#D18EF6" CornerRadius="8" HasShadow="False">
                <Grid Padding="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon Column -->
                    <Image Source="placeholder.png" HeightRequest="30" WidthRequest="30" VerticalOptions="Center" Grid.Column="0"/>

                    <!-- Description Column -->
                    <Label Text="Contact Support" FontSize="Medium" TextColor="Black" VerticalOptions="Center" Padding="10,0,0,0" Grid.Column="1"/>

                    <!-- Action Text Column -->
                    <Label Text="Get Help" FontSize="Small" TextColor="Black" VerticalOptions="Center" HorizontalOptions="End" Grid.Column="2"/>
                </Grid>
            </Frame>

            <!-- Logout -->
            <Frame Padding="0" BackgroundColor="#D18EF6" CornerRadius="8" HasShadow="False">
                <Grid Padding="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon Column -->
                    <Image Source="placeholder.png" HeightRequest="30" WidthRequest="30" VerticalOptions="Center" Grid.Column="0"/>

                    <!-- Description Column -->
                    <Label Text="Logout" FontSize="Medium" TextColor="Black" VerticalOptions="Center" Padding="10,0,0,0" Grid.Column="1"/>

                    <!-- Action Text Column -->
                    <Label Text="Sign out" FontSize="Small" TextColor="Black" VerticalOptions="Center" HorizontalOptions="End" Grid.Column="2"/>
                </Grid>
            </Frame>
        </StackLayout>
    </StackLayout>
</ContentPage>
