<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:view="clr-namespace:MauiApp1.Views"
             x:Class="MauiApp1.Views.PatientDetailsPage"
             Title="PatientDetailsPage">
    <StackLayout Padding="0" Spacing="20">
        <!-- Navbar with Title and Settings Icon -->
        <Grid BackgroundColor="#8e44ad" Padding="10" VerticalOptions="Start">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Back button on the left -->
            <ImageButton Grid.Column="0"
                     Source="arrow_left.png"
                     BackgroundColor="Transparent"
                     WidthRequest="30"
                     HeightRequest="30"
                     VerticalOptions="Center"
                     Aspect="AspectFit"
                     Clicked="OnBackButtonTapped" />

            <!-- Profile Title in the center -->
            <Label Grid.Column="1"
               Text="Profile"
               FontAttributes="Bold"
               VerticalOptions="Center"
               HorizontalOptions="Center"
               FontSize="22"
               TextColor="White" />

            <!-- Settings Icon on the right -->
            <ImageButton Grid.Column="2"
                     Source="settings.png"
                     BackgroundColor="Transparent"
                     WidthRequest="30"
                     HeightRequest="30"
                     VerticalOptions="Center"
                     Aspect="AspectFit"
                     Clicked="OnSettingsIconTapped" />
        </Grid>

        <!-- Profile Details Form -->
        <Frame Padding="20" CornerRadius="15" BackgroundColor="White" HasShadow="True" Margin="10">
            <StackLayout Spacing="15">
                <Label Text="First Name" TextColor="#333" FontSize="16"/>
                <Frame CornerRadius="10" Padding="0" BackgroundColor="#e8e8e8" HeightRequest="45">
                    <Label Text="{Binding User.Name}"
                       BackgroundColor="Transparent"
                       TextColor="#333"
                       FontSize="16"
                       VerticalTextAlignment="Center"/>
                </Frame>

                <Label Text="Last Name" TextColor="#333" FontSize="16"/>
                <Frame CornerRadius="10" Padding="0" BackgroundColor="#e8e8e8" HeightRequest="45">
                    <Label Text="{Binding User.Surname}"
                       BackgroundColor="Transparent"
                       TextColor="#333"
                       FontSize="16"
                       VerticalTextAlignment="Center"/>
                </Frame>

                <Label Text="Email" TextColor="#333" FontSize="16"/>
                <Frame CornerRadius="10" Padding="0" BackgroundColor="#e8e8e8" HeightRequest="45">
                    <Label Text="{Binding User.Email}"
                       BackgroundColor="Transparent"
                       TextColor="#333"
                       FontSize="16"
                       VerticalTextAlignment="Center"/>
                </Frame>

                <Label Text="Phone Number" TextColor="#333" FontSize="16"/>
                <Frame CornerRadius="10" Padding="0" BackgroundColor="#e8e8e8" HeightRequest="45">
                    <Label Text="{Binding User.PhoneNo}"
                       BackgroundColor="Transparent"
                       TextColor="#333"
                       FontSize="16"
                       VerticalTextAlignment="Center"/>
                </Frame>

                <Label Text="Address" TextColor="#333" FontSize="16"/>
                <Frame CornerRadius="10" Padding="0" BackgroundColor="#e8e8e8" HeightRequest="45">
                    <Label Text="{Binding User.Address}"
                       BackgroundColor="Transparent"
                       TextColor="#333"
                       FontSize="16"
                       VerticalTextAlignment="Center"/>
                </Frame>

               
            </StackLayout>
        </Frame>
    </StackLayout>
</ContentPage>