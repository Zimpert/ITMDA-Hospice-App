<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Views.PatientMiddlePage">
    <ScrollView >
        <StackLayout BackgroundColor="White">

            <!-- Navbar with Title and Settings Icon -->
            <Frame BackgroundColor="#9b59b6" CornerRadius="0" HasShadow="True"
           HorizontalOptions="FillAndExpand" VerticalOptions="Start">
                <Grid Padding="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Back button on the left -->
                    <ImageButton Grid.Column="0"
                                 Source="arrow_left.png"
                                 BackgroundColor="Transparent"
                                 WidthRequest="30"
                                 HeightRequest="30"
                                 VerticalOptions="Center"
                                 Aspect="AspectFit"
                                 Clicked="OnBackButtonTapped" />

                    <!-- Home Title in the center -->
                    <Label Grid.Column="1"
                   Text="Patient Hub"
                   FontAttributes="Bold"
                   VerticalOptions="Center"
                   HorizontalOptions="Center"
                   FontSize="18"
                   TextColor="White" />

                    <!-- Settings Icon on the right -->
                    <ImageButton Grid.Column="2"
                         Source="settings.png"
                         BackgroundColor="Transparent"
                         WidthRequest="30"
                         HeightRequest="30"
                         VerticalOptions="Center"
                         Aspect="AspectFit"
                         Clicked="OnSettingsIconTapped" />
                </Grid>
            </Frame>
            <!-- Button Grid with Icons and Text -->
            <Grid Grid.Row="1" Padding="20" RowSpacing="15" ColumnSpacing="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Button-like Frames with Icons and Labels -->
                <Frame Grid.Row="0" Grid.Column="0" BackgroundColor="#9b59b6" CornerRadius="15" HasShadow="True" Padding="10">
                    <StackLayout Orientation="Vertical" HorizontalOptions="Center" VerticalOptions="Center">
                        <StackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnViewPatientInfo" />
                        </StackLayout.GestureRecognizers>
                        <Image Source="care.png" WidthRequest="50" HeightRequest="50" Aspect="AspectFit"/>
                        <Label Text="View Patient Information" TextColor="White" HorizontalOptions="Center" FontAttributes="Bold" FontSize="16" Margin="0,10,0,0"/>
                    </StackLayout>
                </Frame>

                <Frame Grid.Row="0" Grid.Column="1" BackgroundColor="#9b59b6" CornerRadius="15" HasShadow="True" Padding="10">
                    <StackLayout Orientation="Vertical" HorizontalOptions="Center" VerticalOptions="Center">
                        <StackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnViewPatientMedication" />
                        </StackLayout.GestureRecognizers>
                        <Image Source="calendar_lines.png" WidthRequest="50" HeightRequest="50" Aspect="AspectFit"/>
                        <Label Text="View Patient Medication" TextColor="White" HorizontalOptions="Center" FontAttributes="Bold" FontSize="16" Margin="0,10,0,0"/>
                    </StackLayout>
                </Frame>

            </Grid>
        </StackLayout>
    </ScrollView>
</ContentPage>