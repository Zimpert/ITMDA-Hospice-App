<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.NotificationPage"
             Title="Notifications">
    <ScrollView>
        <StackLayout x:Name="NotificationListContainer" Padding="20" BackgroundColor="White">

            <!-- Header -->
            <Grid Padding="0,10,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image Source="arrow_left.png" HeightRequest="30" WidthRequest="30" VerticalOptions="Center"/>
                <Label Text="Notifications" FontSize="Title" TextColor="Black" HorizontalOptions="Center" Grid.Column="1"/>
                <Image Source="settings.png" HeightRequest="30" WidthRequest="30" VerticalOptions="Center" Grid.Column="2"/>
            </Grid>

            <!-- Notifications will be added here dynamically -->
        </StackLayout>
    </ScrollView>
</ContentPage>
