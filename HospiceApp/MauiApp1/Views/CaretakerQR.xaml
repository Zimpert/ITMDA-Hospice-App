<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.CaretakerQR"
             Shell.NavBarIsVisible="False"
             Title="CaretakerQR">

    <StackLayout Padding="0" BackgroundColor="White">

        <!-- Navbar with Title and Settings Icon -->
        <Frame Grid.Row="0" BackgroundColor="#9b59b6" CornerRadius="0" HasShadow="True"
               HorizontalOptions="FillAndExpand" VerticalOptions="Start">
            <Grid Padding="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Back button on the left -->
                <ImageButton Grid.Column="0"
                             Source="arrow_left.png"
                             BackgroundColor="Transparent"
                             WidthRequest="30"
                             HeightRequest="30"
                             VerticalOptions="Center"
                             Aspect="AspectFit"
                             Clicked="OnBackButtonTapped" />   

                <!-- Home Title in the center -->
                <Label Grid.Column="1"
                       Text="QR Page"
                       FontAttributes="Bold"
                       VerticalOptions="Center"
                       HorizontalOptions="Center"
                       FontSize="18"
                       TextColor="White" />    

                <!-- Settings Icon on the right -->
                <ImageButton Grid.Column="2"
                             Source="settings.png"
                             BackgroundColor="Transparent"
                             WidthRequest="30"
                             HeightRequest="30"
                             VerticalOptions="Center"
                             Aspect="AspectFit"
                             Clicked="OnSettingsIconTapped" />
            </Grid>
        </Frame>


        <!-- Profile Picture -->
        <Frame HeightRequest="100" WidthRequest="100"
           CornerRadius="50" 
           BackgroundColor="Purple"
           VerticalOptions="Center"
           HorizontalOptions="Center"
           Margin="0,20,0,10">
            <Image Source="placeholder.png" 
               VerticalOptions="Center"
               HorizontalOptions="Center"/>
        </Frame>

        <!-- Name and Role -->
        <Label Text="Alexa Williams" 
           FontSize="Large" 
           TextColor="Black"
           HorizontalOptions="Center" />
        <Label Text="Caregiver" 
           FontSize="Medium" 
           TextColor="Black"
           HorizontalOptions="Center"
           Margin="0,0,0,20"/>

        <!-- Description Text -->
        <Label Text="Your personal QR code."
           TextColor="Black"
           FontSize="Small"
           HorizontalTextAlignment="Start"
           Margin="20,0,0,0" />
        <Label Text="Patients will scan this code to clock you in and out."
           TextColor="Black"
           FontSize="Small"
           HorizontalTextAlignment="Start"
           Margin="20,0,0,20" />

        <!-- Clock In/Out Radio Buttons -->
        <StackLayout Orientation="Horizontal" HorizontalOptions="Center" Margin="0,0,0,20">
            <Image Source="placeholder.png" VerticalOptions="Center" Margin="0,0,0,0"  HeightRequest="60" WidthRequest="60"/>
            <StackLayout>
                <StackLayout Orientation="Horizontal" VerticalOptions="Center">
                    <RadioButton Content="Clocked In" IsChecked="True" TextColor="Black" Margin="20,5,0,0"/>
                    <RadioButton Content="Clocked Out" IsChecked="False" TextColor="Black" Margin="10,5,0,0"/>
                </StackLayout>
            </StackLayout>
        </StackLayout>

        <!-- QR Code Image -->
        <Frame HeightRequest="200" WidthRequest="200" BorderColor="Gray" CornerRadius="10" HorizontalOptions="Center" VerticalOptions="Center">
            <Image Source="placeholder.png" Aspect="AspectFit"/>
        </Frame>

        <!-- Save Button -->
        <Button Text="Save to Camera Roll" 
            BackgroundColor="Green" 
            TextColor="Black" 
            FontSize="Medium"
            CornerRadius="10"
            VerticalOptions="End" 
            HorizontalOptions="FillAndExpand"
            Margin="0,20,0,0" />

    </StackLayout>
    
</ContentPage>