<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Views.CaretakerQR"
             Shell.NavBarIsVisible="False"
             Title="CaretakerQR"
             xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI.Controls">

    <ScrollView>
        <StackLayout Padding="0"
                     BackgroundColor="White">

            <!-- Navigation Bar -->
            <Grid BackgroundColor="#9b59b6"
                  Padding="10"
                  HeightRequest="100">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Back Button -->
                <ImageButton Grid.Column="0"
                             Source="arrow_left.png"
                             BackgroundColor="Transparent"
                             WidthRequest="30"
                             HeightRequest="30"
                             VerticalOptions="Center"
                             Clicked="OnBackButtonTapped"
                             AutomationId="BackButton"
                             SemanticProperties.Hint="Go back" />

                <!-- Title -->
                <Label Grid.Column="1"
                       Text="QR Page"
                       FontAttributes="Bold"
                       VerticalOptions="Center"
                       HorizontalOptions="Center"
                       FontSize="18"
                       TextColor="White"
                       AutomationId="PageTitle" />

                <!-- Settings Icon -->
                <ImageButton Grid.Column="2"
                             Source="settings.png"
                             BackgroundColor="Transparent"
                             WidthRequest="30"
                             HeightRequest="30"
                             VerticalOptions="Center"
                             Clicked="OnSettingsIconTapped"
                             AutomationId="SettingsButton"
                             SemanticProperties.Hint="Open settings" />
            </Grid>

            <!-- Profile Picture -->
            <Frame HeightRequest="100"
                   WidthRequest="100"
                   CornerRadius="50"
                   BorderColor="#9b59b6"
                   VerticalOptions="Center"
                   HorizontalOptions="Center"
                   Padding="0"
                   Margin="0,20,0,10">
                <Image Source="placeholder.png"
                       Aspect="AspectFill"
                       HeightRequest="100"
                       WidthRequest="100"
                       AutomationId="ProfileImage" />
            </Frame>

            <!-- Name and Role -->
            <Label Text="Alexa Williams"
                   FontSize="Title"
                   TextColor="Black"
                   HorizontalOptions="Center"
                   FontAttributes="Bold"
                   AutomationId="UserName" />
            <Label Text="Caregiver"
                   FontSize="Subtitle"
                   TextColor="Gray"
                   HorizontalOptions="Center"
                   Margin="0,0,0,20"
                   AutomationId="UserRole" />

            <!-- Description Text -->
            <StackLayout Padding="20,0">
                <Label Text="Your personal QR code."
                       TextColor="Black"
                       FontSize="Medium"
                       AutomationId="DescriptionText1" />
                <Label Text="Patients will scan this code to clock you in and out."
                       TextColor="Black"
                       FontSize="Small"
                       Margin="0,0,0,20"
                       AutomationId="DescriptionText2" />
            </StackLayout>

            <!-- Clock In/Out Radio Buttons -->
            <StackLayout Orientation="Horizontal"
                         HorizontalOptions="Center"
                         Margin="0,0,0,20">
                <StackLayout Orientation="Horizontal"
                             VerticalOptions="Center">
                    <RadioButton Content="Clocked In"
                                 IsChecked="{Binding IsClockedIn}"
                                 TextColor="Black"
                                 GroupName="ClockStatus"
                                 Margin="0,0,10,0"
                                 AutomationId="ClockedInRadioButton" />
                    <RadioButton Content="Clocked Out"
                                 IsChecked="{Binding IsClockedOut}"
                                 TextColor="Black"
                                 GroupName="ClockStatus"
                                 AutomationId="ClockedOutRadioButton" />
                </StackLayout>
            </StackLayout>

            <!-- QR Code Image -->
            <StackLayout HorizontalOptions="Center"
                         VerticalOptions="Center">
                <Frame WidthRequest="150"
                       HeightRequest="150"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       Padding="0"
                       HasShadow="False"
                       BorderColor="#9b59b6"
                       CornerRadius="10">
                    <zxing:BarcodeGeneratorView Format="QrCode"
                                                Value="test"
                                                HorizontalOptions="Fill"
                                                VerticalOptions="Fill"
                                                AutomationId="QrCodeImage" />
                </Frame>
            </StackLayout>

        </StackLayout>
    </ScrollView>
</ContentPage>
