<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Views.HomePage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource BackgroundColor}">

    <ContentPage.Content>
        <Grid Padding="0" RowSpacing="20" ColumnSpacing="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Custom Navbar with Profile Icon, Title, and Settings Icon -->
            <Frame Grid.Row="0" BackgroundColor="#9b59b6" Padding="10" CornerRadius="0" HasShadow="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Profile Icon on the left -->
                    <ImageButton Grid.Column="0"
                                 Source="user.png"
                                 BackgroundColor="Transparent"
                                 WidthRequest="30"
                                 HeightRequest="30"
                                 VerticalOptions="Center"
                                 Aspect="AspectFit"
                                 Clicked="OnProfileIconTapped" />

                    <!-- Home Title in the center -->
                    <Label Grid.Column="1"
                           Text="Home"
                           FontAttributes="Bold"
                           VerticalOptions="Center"
                           HorizontalOptions="Center"
                           FontSize="18"
                           TextColor="White" />

                    <!-- Settings Icon on the right -->
                    <ImageButton Grid.Column="2"
                                 Source="settings.png"
                                 BackgroundColor="Transparent"
                                 WidthRequest="30"
                                 HeightRequest="30"
                                 VerticalOptions="Center"
                                 Aspect="AspectFit"
                                 Clicked="OnSettingsIconTapped" />
                </Grid>
            </Frame>

            <!-- Button Grid with Icons and Text -->
            <Grid Grid.Row="1" Padding="20" RowSpacing="15" ColumnSpacing="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Button-like Frames with Icons and Labels -->
                <Frame Grid.Row="0" Grid.Column="0" BackgroundColor="#9b59b6" CornerRadius="15" HasShadow="True" Padding="10">
                    <StackLayout Orientation="Vertical" HorizontalOptions="Center" VerticalOptions="Center">
                        <StackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnViewCarerClicked" />
                        </StackLayout.GestureRecognizers>
                        <Image Source="placeholder.png" WidthRequest="50" HeightRequest="50" Aspect="AspectFit"/>
                        <Label Text="View Carer" TextColor="White" HorizontalOptions="Center" FontAttributes="Bold" FontSize="16" Margin="0,10,0,0"/>
                    </StackLayout>
                </Frame>

                <Frame Grid.Row="0" Grid.Column="1" BackgroundColor="#9b59b6" CornerRadius="15" HasShadow="True" Padding="10">
                    <StackLayout Orientation="Vertical" HorizontalOptions="Center" VerticalOptions="Center">
                        <StackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnShiftPageClicked" />
                        </StackLayout.GestureRecognizers>
                        <Image Source="placeholder.png" WidthRequest="50" HeightRequest="50" Aspect="AspectFit"/>
                        <Label Text="Shift Page" TextColor="White" HorizontalOptions="Center" FontAttributes="Bold" FontSize="16" Margin="0,10,0,0"/>
                    </StackLayout>
                </Frame>

                <Frame Grid.Row="1" Grid.Column="0" BackgroundColor="#9b59b6" CornerRadius="15" HasShadow="True" Padding="10">
                    <StackLayout Orientation="Vertical" HorizontalOptions="Center" VerticalOptions="Center">
                        <StackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNotificationPageClicked" />
                        </StackLayout.GestureRecognizers>
                        <Image Source="placeholder.png" WidthRequest="50" HeightRequest="50" Aspect="AspectFit"/>
                        <Label Text="Notification Page" TextColor="White" HorizontalOptions="Center" FontAttributes="Bold" FontSize="16" Margin="0,10,0,0"/>
                    </StackLayout>
                </Frame>

                <Frame Grid.Row="1" Grid.Column="1" BackgroundColor="#9b59b6" CornerRadius="15" HasShadow="True" Padding="10">
                    <StackLayout Orientation="Vertical" HorizontalOptions="Center" VerticalOptions="Center">
                        <StackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnQRScanPageClicked" />
                        </StackLayout.GestureRecognizers>
                        <Image Source="placeholder.png" WidthRequest="50" HeightRequest="50" Aspect="AspectFit"/>
                        <Label Text="QR Scan Page" TextColor="White" HorizontalOptions="Center" FontAttributes="Bold" FontSize="16" Margin="0,10,0,0"/>
                    </StackLayout>
                </Frame>

                <Frame Grid.Row="2" Grid.Column="0" BackgroundColor="#9b59b6" CornerRadius="15" HasShadow="True" Padding="10">
                    <StackLayout Orientation="Vertical" HorizontalOptions="Center" VerticalOptions="Center">
                        <StackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMedicationListClicked" />
                        </StackLayout.GestureRecognizers>
                        <Image Source="placeholder.png" WidthRequest="50" HeightRequest="50" Aspect="AspectFit"/>
                        <Label Text="Medication List" TextColor="White" HorizontalOptions="Center" FontAttributes="Bold" FontSize="16" Margin="0,10,0,0"/>
                    </StackLayout>
                </Frame>

                <Frame Grid.Row="2" Grid.Column="1" BackgroundColor="#9b59b6" CornerRadius="15" HasShadow="True" Padding="10">
                    <StackLayout Orientation="Vertical" HorizontalOptions="Center" VerticalOptions="Center">
                        <StackLayout.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnMedicationTrackerClicked" />
                        </StackLayout.GestureRecognizers>
                        <Image Source="placeholder.png" WidthRequest="50" HeightRequest="50" Aspect="AspectFit"/>
                        <Label Text="Medication Tracker" TextColor="White" HorizontalOptions="Center" FontAttributes="Bold" FontSize="16" Margin="0,10,0,0"/>
                    </StackLayout>
                </Frame>
            </Grid>
        </Grid>
    </ContentPage.Content>

</ContentPage>
